ajn regulojn pri prononcado de Esperanto. Atentu, ke vi prononcu c ĉiam, kiel ts. Atentu, ke vi prononcu ĵ kaj jh, kiel la kroata ž, ankaŭ antaŭ a, o kaj u. Atentu, ke vi prononcu gh kaj ĝ, kiel la kroata dž, ankaŭ antaŭ a, o kaj u. Atentu, ke en la vortoj Nauro, Sauda, Seulo kaj Koreujo la u formas apartan silabon. Bonvolu preteratenti, ke vi ne estas speciale trejnita pri Esperanto.\", \"input\": \"{lv\u003dm}\"}\u0027 --output /storage/emulated/0/dosierujo/vocho.mp3","timeoutSeconds":600,"useHelper":false,"useShizuku":false,"disableLogging":false,"m_SIGUID":-6116608113501200862,"m_classType":"ShellScriptAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"m_delayInMilliSeconds":0,"m_delayInSeconds":1,"m_useAlarm":false,"unitForVariables":0,"disableLogging":false,"m_SIGUID":-7507604907178369014,"m_classType":"PauseAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"alignment":0,"alpha":100,"autoHideAfterDelay":true,"autoHideSeconds":3,"bgColor":-16777216,"corners":12,"drawOverSystemApps":false,"enableShadow":false,"forceFullScreen":false,"hideOnClick":false,"htmlFormattingEnabled":false,"identifier":"Preta","isInitialised":true,"macroGuidToRun":0,"macroNameToRun":"(Deaktiviert)","moveOption":0,"option":0,"padding":8,"preventRemoveByDrag":false,"shadowColor":-16777216,"showOverStatusBar":false,"singleLineScrollingEnabled":false,"textColor":-1,"textSize":14,"textToDisplay":"Preta!","updateLocation":false,"updateVariableOnMove":false,"variableWidth":true,"vibrateOnClick":false,"widthPercentage":90,"xPosition":0.5,"yPosition":0.5,"disableLogging":false,"m_SIGUID":-6265116693318233286,"m_classType":"FloatingTextAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"m_delayInMilliSeconds":0,"m_delayInSeconds":1,"m_useAlarm":false,"unitForVariables":0,"disableLogging":false,"m_SIGUID":-7030446087504629019,"m_classType":"PauseAction","m_comment":"","m_con