{"globalVariables":[],"macro":{"aiGenerated":0,"breakpoints":[],"disabledTimestamp":0,"exportedActionBlocks":[],"forceEvenIfNotEnabledTimestamp":0,"isActionBlock":false,"isExtra":false,"isFavourite":false,"lastEditedTimestamp":1780043688185,"localVariables":[{"description":"","dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"enigo","m_stringValue":"Saluton, mondo! Tiu ĉi makroo atendas enigon de teksto, ĝin konservas en variablo enigo kaj kreas sondosieron voĉo punkto mo po tri per shel-skripto kombine kun go-po-to-kvar-o-mini-to-to-so.","m_type":2,"supportsInput":true,"supportsOutput":true}],"localVarsAlphabetical":true,"m_GUID":-7769912134111962452,"m_actionList":[{"booleanDictionaryKeys":{"keys":[]},"dictionaryKeys":[],"dictionaryOrArrayType":-1,"existingManualKeyType":0,"m_booleanInvert":false,"m_darkMode":0,"m_doubleRandomMax":0.0,"m_doubleRandomMin":0.0,"m_falseLabel":"Falsch","m_intExpression":false,"m_intRandom":false,"m_intRandomMax":0,"m_intRandomMin":0,"m_intValueDecrement":false,"m_intValueIncrement":false,"m_newBooleanValue":false,"m_newDoubleValue":0.0,"m_newIntValue":0,"m_newStringValue":"","m_trueLabel":"Wahr","m_userPrompt":true,"m_userPromptEmptyAtStart":false,"m_userPromptMessage":"Bv. enigi la parolotan tekston:","m_userPromptPassword":false,"m_userPromptShowCancel":true,"m_userPromptStopAfterCancel":true,"m_userPromptTitle":"Texto-enigo","m_variable":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"enigo","m_stringValue":"","m_type":2,"supportsInput":true,"supportsOutput":true},"disableLogging":false,"m_SIGUID":-7009024161333317530,"m_classType":"SetVariableAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"m_delayInMilliSeconds":0,"m_delayInSeconds":1,"m_useAlarm":false,"unitForVariables":0,"disableLogging":false,"m_SIGUID":-5873128323901548820,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"m_nonRoot":true,"m_script":"curl https://api.openai.com/v1/audio/speech -H \"Authorization: Bearer sk-anstatauigu_per_valida_api_shlosilo\" -H \"Content-Type: application/json\" -d \u0027{\"model\":\"gpt-4o-mini-tts\",\"voice\":\"nova\",\"speed\":1,\"instructions\":\"Bonvolu supozi, ke ĉiuj nombroj, ankaŭ tiuj de jaroj, de jena teksto estas skribitaj, kiel Esperanto-vortoj, kaj poste legi la tekston inkluzive de mallongigoj, kvazaŭ vi estus denaska parolanto de Esperanto. 0: nul; 1: unu; 2: du; 3: tri; 4: kvar, 5: kvin; 6: ses; 7: sep, 8: ok; 9: naŭ; 10: dek; 100: cent; 900: naŭcent; 1000: mil. Atentu severe la oficialajn regulojn pri prononcado de Esperanto. Atentu, ke vi prononcu c ĉiam, kiel ts. Atentu, ke vi prononcu ĵ kaj jh, kiel la kroata ž, ankaŭ antaŭ a, o kaj u. Atentu, ke vi prononcu gh kaj ĝ, kiel la kroata dž, ankaŭ antaŭ a, o kaj u. Atentu, ke en la vortoj Nauro, Sauda, Seulo kaj Koreujo la u formas apartan silabon. Bonvolu preteratenti, ke vi ne estas speciale trejnita pri Esperanto.\", \"input\": \"{lv\u003denigo}\"}\u0027 --output /storage/emulated/0/dosierujo/vocho.mp3","timeoutSeconds":600,"useHelper":false,"useShizuku":false,"disableLogging":false,"m_SIGUID":-7502268389314467778,"m_classType":"ShellScriptAction","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"m_delayInMilliSeconds":0,"m_delayInSeconds":1,"m_useAlarm":false,"unitForVariables":0,"disableLogging":false,"m_SIGUID":-5754648857456492782,"m_classType":"PauseAction","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"alignment":0,"alpha":100,"autoHideAfterDelay":true,"autoHideSeconds":3,"bgColor":-16777216,"corners":12,"drawOverSystemApps":fal